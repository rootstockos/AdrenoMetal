+
+/// `first` then `second`, those of them there are, as the first `.1` of the array: the global
+/// barriers of a command buffer of barriers a batch records (the completed work's or the exit's,
+/// then an encoder's or the batch's end), which take no allocation.
+fn barrier_pair(first: Option<Barrier>, second: Option<Barrier>) -> ([Barrier; 2], usize) {
+    let mut pair = [Barrier::default(); 2];
+    let mut count = 0;
+    for barrier in first.into_iter().chain(second) {
+        pair[count] = barrier;
+        count += 1;
+    }
+    (pair, count)
+}
