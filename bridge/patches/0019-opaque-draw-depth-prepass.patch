diff --git a/crates/metal2vulkan-runtime/src/render/opaque_prepass.rs b/crates/metal2vulkan-runtime/src/render/opaque_prepass.rs
new file mode 100644
index 00000000..f2d7e4a1
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/render/opaque_prepass.rs
@@ -0,0 +1,207 @@
+//! The depth prepass of a pass's opaque draws: hidden-surface removal for a pass without a depth
+//! attachment.
+//!
+//! - **Why.** Apple's GPUs shade a pixel of a pass once per visible fragment: a fragment an
+//!   opaque fragment drawn later covers is never shaded. A Vulkan device shades every fragment a
+//!   draw rasterizes, in order, so a pass that stacks layers, opaque ones over earlier ones,
+//!   shades each covered pixel again for every layer. The render server of a tablet's
+//!   compositor draws most of its full-screen passes so: at least 44 % of the samples it shaded
+//!   (a trace of an Adreno 810's passes, 8.4 G samples) lay under a later opaque draw that
+//!   covered the whole pass.
+//! - **How.** Such a pass renders with a depth attachment of its own, which Metal does not see
+//!   (`attachment_stand_in::prepass_depth`, [`DepthStencilTarget::prepass`]): cleared to 1.0 as
+//!   the pass begins, never stored. Each draw takes the depth of its place in the pass, a code of
+//!   that 16-bit depth nearer than every earlier draw's ([`Prepass::next_depth`]), through its
+//!   viewports' collapsed depth range, which leaves its rasterization alone. Each draw that hides
+//!   what it covers ([`Role::Occludes`]) records twice: once into the instance's prepass, a
+//!   secondary command buffer every instance's subpass runs before its draws, with its colors
+//!   masked, the depth test `LESS` and depth writes; and once among the instance's draws, as
+//!   every draw records, with the depth test `LESS_OR_EQUAL` and no depth write. After the
+//!   prepass each pixel holds the depth of the last opaque draw that covers it, so in the draws a
+//!   fragment passes only where no later opaque draw covers it: what Metal shows, each covered
+//!   fragment unshaded. A draw that may not be hidden ([`Role::Untested`]) draws with the depth
+//!   test off, as before.
+//! - **Which passes.** A pass of colors only, one sample, one layer, no visibility buffer, custom
+//!   sample positions, rasterization-rate map, framebuffer fetch, tile memory, color groups or
+//!   extended-range shadows that keep its draws ([`admits`]). Its first instance records in a
+//!   secondary command buffer, as any pass with a depth attachment (`inline_first.rs`).
+//! - **Which draws.** One hides what it covers where it is opaque over every color whose texels
+//!   outlive the pass (no blending, every channel written), its fragment function writes no
+//!   depth and no memory (it runs again in the prepass), and it draws in the plain way (no
+//!   tessellation, mesh, imageblock, fetch, amplification or rerouted colors, no depth bias or
+//!   compensated depth). One may be hidden where its fragment function writes no memory and no
+//!   depth and no visibility result counts its samples. A draw recorded later, once its pipeline
+//!   is made (`render/pending.rs`), or into an instance recorded inline after a split
+//!   (`render/inline_splits.rs`), or for an execution or a replay, records no prepass: it hides
+//!   nothing, which is never wrong.
+//! - **The bound.** A pass of more draws than the depth's codes ([`MOST_DRAWS`]) draws the rest
+//!   with the depth test off.
+
+use super::extended_shadow::ExtendedShadows;
+use crate::color_reformat::Routing;
+use crate::encoder::EncoderCore;
+use crate::pipeline::FixedState;
+use crate::pipeline::RawPipeline;
+use crate::render_pass::{DepthStencilTarget, PassLayout, Target};
+use crate::render_values::StoreAction;
+use metal2vulkan::pipeline::{ColorAttachmentState, GraphicsState};
+use metal2vulkan::vk::ColorComponentFlags;
+use std::sync::Arc;
+
+/// The draws of a pass that take a depth of their own: the 16-bit depth's codes below 1.0 but
+/// one (its first draw's code is the largest).
+pub(super) const MOST_DRAWS: u32 = 65534;
+
+/// Whether a pass of `layout` renders its opaque draws' prepass (the module docs).
+pub(super) fn admits(
+    layout: &PassLayout,
+    rate_mapped: bool,
+    grouped: bool,
+    extended: &ExtendedShadows,
+) -> bool {
+    layout.depth_stencil.is_none()
+        && layout.colors.iter().flatten().next().is_some()
+        && layout.samples == 1
+        && layout.layers <= 1
+        && layout.visibility.is_none()
+        && layout.sample_positions.is_empty()
+        && !layout.fetch_inputs
+        && layout.tile.threadgroup_memory_length == 0
+        && layout.tile.sample_length == 0
+        && layout.fails_command_buffer.is_none()
+        && !rate_mapped
+        && !grouped
+        && !extended.keeps_draws()
+}
+
+/// A pass's prepass, as its draws take their depths.
+#[derive(Default)]
+pub(super) struct Prepass {
+    /// The pass renders it ([`admits`]).
+    pub(super) on: bool,
+    /// The draws that took a depth so far.
+    draws: u32,
+    /// The prepass `VkPipeline` its last draw retained ([`retain`](Prepass::retain)).
+    retained: Option<Arc<RawPipeline>>,
+}
+
+impl Prepass {
+    /// The prepass of a pass that `on` admits.
+    pub(super) fn of(on: bool) -> Prepass {
+        Prepass {
+            on,
+            draws: 0,
+            retained: None,
+        }
+    }
+
+    /// Retain into `core` the prepass `VkPipeline` a draw records, unless the draw before took
+    /// the same one: held until the command buffer completes, as the draws' own are.
+    pub(super) fn retain(&mut self, core: &mut EncoderCore, made: &Arc<RawPipeline>) {
+        if !self.retained.as_ref().is_some_and(|r| Arc::ptr_eq(r, made)) {
+            core.retain_shared(made.clone());
+            self.retained = Some(Arc::clone(made));
+        }
+    }
+
+    /// The depth of the pass's next draw, nearer than every earlier draw's: `None` past
+    /// [`MOST_DRAWS`], or where the pass renders no prepass.
+    pub(super) fn next_depth(&mut self) -> Option<f32> {
+        if !self.on || self.draws >= MOST_DRAWS {
+            return None;
+        }
+        self.draws += 1;
+        Some((65535 - self.draws) as f32 / 65535.0)
+    }
+}
+
+/// What a draw is to its pass's prepass (the module docs).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Role {
+    /// It hides what it covers: it records into the prepass too.
+    Occludes,
+    /// It may be hidden: it tests the prepass's depth.
+    Tested,
+    /// It draws as without a prepass: no depth test.
+    Untested,
+}
+
+/// What a draw of `graphics` is to its pass of `layout`, its colors routed by `routing`, where a
+/// visibility result `counts` its samples and its depth is `biased` or compensated (the module
+/// docs).
+pub(super) fn role(
+    graphics: &GraphicsState,
+    layout: &PassLayout,
+    routing: &Routing,
+    counts: bool,
+    biased: bool,
+) -> Role {
+    let g = graphics;
+    let plain = plain(g) && routing.locations.is_empty() && !counts && !biased;
+    if !plain {
+        return Role::Untested;
+    }
+    let opaque = layout.colors.iter().enumerate().all(|(index, color)| {
+        let Some(color) = color else { return true };
+        // A color whose texels end with the pass, which no draw reads in it.
+        let ends = color.store == StoreAction::DontCare
+            && !color.late_store
+            && color.resolve.is_none()
+            && color.copied_resolve.is_none();
+        let written = g.color_attachments.get(index).and_then(Option::as_ref);
+        ends || written.is_some_and(opaque)
+    });
+    match opaque {
+        true => Role::Occludes,
+        false => Role::Tested,
+    }
+}
+
+/// Whether a draw of `g` may hide what it covers, or be hidden, as far as its pipeline alone
+/// says (the module docs): its fragment function writes no depth and no memory, and it draws in
+/// the plain way.
+fn plain(g: &GraphicsState) -> bool {
+    !g.writes_depth
+        && !g.fragment_writes_memory
+        && !g.rasterizer_discard
+        && g.tessellation.is_none()
+        && g.emulated_tessellation.is_none()
+        && g.mesh_records.is_none()
+        && g.fragment_imageblock.is_none()
+        && g.input_attachments.is_empty()
+        && g.max_vertex_amplification_count <= 1
+}
+
+/// Whether a color state writes every channel of its attachment, unblended.
+fn opaque(c: &ColorAttachmentState) -> bool {
+    let all = ColorComponentFlags::R
+        | ColorComponentFlags::G
+        | ColorComponentFlags::B
+        | ColorComponentFlags::A;
+    c.blend.is_none() && c.write_mask.contains(all)
+}
+
+/// Whether every draw of `g` in a pass whose colors are all its own hides what it covers, as its
+/// pipeline alone says: what a state's creation makes the prepass's `VkPipeline` for
+/// (`pipeline/predicted.rs`).
+pub(crate) fn occludes_alone(g: &GraphicsState) -> bool {
+    plain(g)
+        && g.color_attachments.iter().any(Option::is_some)
+        && g.color_attachments.iter().flatten().all(opaque)
+}
+
+/// `fixed`, a draw's fixed state, as the prepass records the draw: its colors masked, the depth
+/// tested `LESS` and written.
+pub(crate) fn prepass_fixed(mut fixed: FixedState) -> FixedState {
+    fixed.masks_color = true;
+    let ds = &mut fixed.depth_stencil;
+    ds.depth_test_enable = true;
+    ds.depth_write_enable = true;
+    ds.depth_compare_op = metal2vulkan::vk::CompareOp::LESS;
+    fixed
+}
+
+/// The prepass's depth target of a pass, from its image (`attachment_stand_in::prepass_depth`).
+pub(super) fn target(image: Target) -> DepthStencilTarget {
+    DepthStencilTarget::prepass(image)
+}
