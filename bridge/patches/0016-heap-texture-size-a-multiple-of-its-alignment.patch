diff --git a/crates/metal2vulkan-runtime/src/texture/heap.rs b/crates/metal2vulkan-runtime/src/texture/heap.rs
index 6f15f1b3..e258f8c8 100644
--- a/crates/metal2vulkan-runtime/src/texture/heap.rs
+++ b/crates/metal2vulkan-runtime/src/texture/heap.rs
@@ -1861,6 +1861,16 @@ impl Device {
                 metal_layout = tiles;
             }
         }
+        // Where the answer is the device's rather than Metal's (no Metal answer modelled, or one
+        // the texture could not be held to) and its image needs a coarser alignment than its size
+        // is a multiple of (Turnip: 4 KiB), the size grows to a multiple of it: Metal's sizes are
+        // multiples of its alignment, so a heap sized as the sum of its textures' sizes holds them
+        // in any order, where otherwise each texture placed after one pads past what the heap was
+        // sized for.
+        let devices = metal_answer.is_none() || past_metal.is_some();
+        if devices && image.route != AliasRoute::Tiled {
+            size_and_align.size = size_and_align.size.next_multiple_of(size_and_align.align.max(1));
+        }
         // Only a texture an image of binds into the heap's own memory is held to the heap's base,
         // and the routes decide that (`holds_heap_base`).
         check_heap_base(image.route, size_and_align.align)?;
