diff --git a/crates/metal2vulkan-runtime/src/tests/opaque_prepass.rs b/crates/metal2vulkan-runtime/src/tests/opaque_prepass.rs
new file mode 100644
index 00000000..4c8f42bf
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/opaque_prepass.rs
@@ -0,0 +1,230 @@
+//! A pass of colors alone that stacks blended and opaque layers renders its opaque draws' depth
+//! prepass (`render/opaque_prepass.rs`): every opaque draw records into its instance's prepass too
+//! (`WorkCounts::opaque_prepass_draws`), and the target holds what the draws show in order, each
+//! blended layer over what the layers before it left, each opaque one in place of them, as plain
+//! Metal shows them.
+//!
+//! A device test: compiled only under the validation crate's GPU safety cfgs (`m2v_gpu`,
+//! `m2v_cpu_icd`), on the kind of device the cfg selects. The functions are `tob_rect` and
+//! `tob_solid` of the owned fixture `validation/fixtures/public/engine/tob_renders.ll`
+//! (`llvm-as`).
+
+use crate::{
+    BlitOption, Device, DeviceKind, DeviceOptions, LoadAction, Origin, PipelineOptions,
+    RenderCommandEncoder, RenderPassDescriptor, RenderPipelineState, ResourceOptions,
+    ShaderCacheOptions, Size, StoreAction, TextureDescriptor,
+};
+use metal2vulkan::metal::{BlendFactor, BlendOperation, PixelFormat, PrimitiveType, TextureUsage};
+use metal2vulkan::pipeline::{ColorAttachmentDescriptor, RenderPipelineDescriptor, StageSource};
+use std::path::{Path, PathBuf};
+use std::time::Duration;
+
+/// The longest the command buffer may take.
+const WAIT: Duration = Duration::from_secs(60);
+
+/// The target's side, in pixels.
+const SIDE: u64 = 32;
+
+/// A scratch directory for the device's shader cache, removed when dropped.
+struct Scratch(PathBuf);
+
+impl Scratch {
+    fn new() -> Scratch {
+        let name = format!("m2v-opaque-prepass-{}", std::process::id());
+        let path = std::env::temp_dir().join(name);
+        std::fs::create_dir_all(&path).unwrap();
+        Scratch(path)
+    }
+}
+
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// The device the cfg selects: a CPU device under `m2v_cpu_icd`, else a GPU, its shader cache
+/// in `cache`.
+fn device(cache: &Path) -> Device {
+    let options = DeviceOptions {
+        kinds: match cfg!(m2v_cpu_icd) {
+            true => vec![DeviceKind::Cpu],
+            false => vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ],
+        },
+        shader_cache: ShaderCacheOptions {
+            directory: Some(cache.to_owned()),
+            ..ShaderCacheOptions::default()
+        },
+        ..DeviceOptions::default()
+    };
+    Device::system_default_with(&options).unwrap()
+}
+
+fn floats(v: [f32; 4]) -> Vec<u8> {
+    v.iter().flat_map(|f| f.to_le_bytes()).collect()
+}
+
+/// The corners, in normalized device coordinates, of the target's pixels `[x0, x1) x [y0, y1)`.
+fn corners([x0, y0, x1, y1]: [u64; 4]) -> Vec<u8> {
+    let x = |p: u64| p as f32 / SIDE as f32 * 2.0 - 1.0;
+    let y = |p: u64| 1.0 - p as f32 / SIDE as f32 * 2.0;
+    floats([x(x0), y(y1), x(x1), y(y0)])
+}
+
+/// Fill the box `rect` with `color`, in 255ths.
+fn fill(
+    encoder: &mut RenderCommandEncoder,
+    state: &RenderPipelineState,
+    rect: [u64; 4],
+    color: [u8; 4],
+) {
+    encoder.set_render_pipeline_state(state).unwrap();
+    encoder.set_vertex_bytes(&corners(rect), 0).unwrap();
+    let color = color.map(|c| f32::from(c) / 255.0);
+    encoder.set_fragment_bytes(&floats(color), 0).unwrap();
+    encoder
+        .draw_primitives(PrimitiveType::Triangle, 0, 6, 1, 0)
+        .unwrap();
+}
+
+/// The fixture's state of `tob_rect` and `tob_solid`, one `RGBA8Unorm` target, blended
+/// source-over where `blended`.
+fn state(device: &Device, blended: bool) -> RenderPipelineState {
+    let ll = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../metal2vulkan-validation/fixtures/public/engine/tob_renders.ll");
+    let bitcode = metal2vulkan_devtools::llvm_assemble(&ll).unwrap();
+    let library = metal2vulkan::library::Library::from_air(&bitcode).unwrap();
+    let library = device.new_library_with_compile_library(library);
+    let vertex = library.new_function_with_name("tob_rect").unwrap();
+    let fragment = library.new_function_with_name("tob_solid").unwrap();
+    let mut descriptor =
+        RenderPipelineDescriptor::new(StageSource::Function(vertex.function_descriptor()));
+    descriptor.fragment = Some(StageSource::Function(fragment.function_descriptor()));
+    let mut color = ColorAttachmentDescriptor::new(PixelFormat::RGBA8Unorm);
+    if blended {
+        color.blending_enabled = true;
+        color.source_rgb_blend_factor = BlendFactor::SourceAlpha;
+        color.destination_rgb_blend_factor = BlendFactor::OneMinusSourceAlpha;
+        color.rgb_blend_operation = BlendOperation::Add;
+        color.source_alpha_blend_factor = BlendFactor::One;
+        color.destination_alpha_blend_factor = BlendFactor::OneMinusSourceAlpha;
+        color.alpha_blend_operation = BlendOperation::Add;
+    }
+    descriptor.color_attachments[0] = Some(color);
+    device
+        .new_render_pipeline_state(&descriptor, &PipelineOptions::default())
+        .unwrap()
+}
+
+/// The layers, in draw order: the box, its red and alpha in 255ths, and whether it blends.
+const LAYERS: [([u64; 4], u8, u8, bool); 6] = [
+    ([0, 0, 32, 32], 40, 128, true),
+    ([4, 4, 28, 28], 90, 255, false),
+    ([2, 6, 20, 30], 200, 96, true),
+    ([8, 8, 24, 24], 150, 255, false),
+    ([10, 2, 30, 14], 250, 160, true),
+    ([12, 12, 20, 20], 60, 255, false),
+];
+
+/// What the layers leave at pixel `(x, y)`, red then alpha, from `before`: each blended one
+/// source-over, each opaque one in place.
+fn shown(x: u64, y: u64, before: [f32; 2]) -> [f32; 2] {
+    let mut at = before;
+    for ([x0, y0, x1, y1], red, alpha, blended) in LAYERS {
+        if !((x0..x1).contains(&x) && (y0..y1).contains(&y)) {
+            continue;
+        }
+        let (r, a) = (f32::from(red) / 255.0, f32::from(alpha) / 255.0);
+        at = match blended {
+            true => [r * a + at[0] * (1.0 - a), a + at[1] * (1.0 - a)],
+            false => [r, a],
+        };
+    }
+    at
+}
+
+#[test]
+fn opaque_layers_hide_what_they_cover_and_the_target_holds_what_metal_shows() {
+    let scratch = Scratch::new();
+    let device = device(&scratch.0);
+    let queue = device.new_command_queue().unwrap();
+    let (opaque, blended) = (state(&device, false), state(&device, true));
+    let mut d = TextureDescriptor::texture_2d(PixelFormat::RGBA8Unorm, SIDE, SIDE, false);
+    d.usage = TextureUsage::RENDER_TARGET;
+    d.resource_options = ResourceOptions::private();
+    let target = device.new_texture(&d).unwrap();
+    let back = device
+        .new_buffer(SIDE * SIDE * 4, ResourceOptions::shared())
+        .unwrap();
+    let mut pass = RenderPassDescriptor::new();
+    let color = &mut pass.color_attachments[0];
+    color.texture = Some(target.clone());
+    color.load_action = LoadAction::Clear;
+    color.store_action = StoreAction::Store;
+    let layers = |encoder: &mut RenderCommandEncoder| {
+        for (rect, red, alpha, blends) in LAYERS {
+            let state = match blends {
+                true => &blended,
+                false => &opaque,
+            };
+            fill(encoder, state, rect, [red, 0, 0, alpha]);
+        }
+    };
+    // A first pass makes the `VkPipeline`s: a draw whose pipeline is being made records later,
+    // without its prepass (`render/pending.rs`).
+    let first = queue.command_buffer().unwrap();
+    let mut encoder = first.render_command_encoder(&pass).unwrap();
+    layers(&mut encoder);
+    encoder.end_encoding().unwrap();
+    first.commit().unwrap();
+    first.wait_until_completed_for(WAIT).unwrap();
+    let counted = device.work_counts();
+    let command_buffer = queue.command_buffer().unwrap();
+    let mut encoder = command_buffer.render_command_encoder(&pass).unwrap();
+    layers(&mut encoder);
+    encoder.end_encoding().unwrap();
+    let mut blit = command_buffer.blit_command_encoder().unwrap();
+    blit.copy_from_texture_to_buffer(
+        &target,
+        0,
+        0,
+        Origin::new(0, 0, 0),
+        Size::new(SIDE, SIDE, 1),
+        &back,
+        0,
+        SIDE * 4,
+        SIDE * SIDE * 4,
+        BlitOption::None,
+    )
+    .unwrap();
+    blit.end_encoding().unwrap();
+    command_buffer.commit().unwrap();
+    command_buffer.wait_until_completed_for(WAIT).unwrap();
+    assert_eq!(command_buffer.error(), None);
+    // The path ran: each of the three opaque layers recorded into the prepass.
+    let after = device.work_counts();
+    assert_eq!(after.opaque_prepass_draws - counted.opaque_prepass_draws, 3);
+    let contents = back.contents().unwrap();
+    // SAFETY: the buffer's bytes, which no command uses now.
+    let bytes = unsafe { std::slice::from_raw_parts(contents.as_ptr(), back.length() as usize) };
+    for y in 0..SIDE {
+        for x in 0..SIDE {
+            // From Metal's default clear color, opaque black.
+            let [red, alpha] = shown(x, y, [0.0, 1.0]);
+            let at = ((y * SIDE + x) * 4) as usize;
+            let close = |got: u8, want: f32| (f32::from(got) - want * 255.0).abs() <= 1.5;
+            assert!(
+                close(bytes[at], red) && close(bytes[at + 3], alpha),
+                "pixel ({x}, {y}): red {} alpha {}, Metal shows {:.1} {:.1}",
+                bytes[at],
+                bytes[at + 3],
+                red * 255.0,
+                alpha * 255.0
+            );
+        }
+    }
+}
