+/// The depth of a pass's opaque-draw prepass (`render/opaque_prepass.rs`): a private
+/// [`PREPASS_DEPTH_FORMAT`] image of the pass's extent, one sample and one layer, as a
+/// depth/stencil attachment only. Its pass clears it as it begins and stores nothing of it, so no
+/// pass reads what another left, and one image serves every such pass of the extent on
+/// `maker`'s queue, kept in the queue's pool as a memoryless color's backing is
+/// ([`pooled_backing`]): the passes that take it are ordered by their uses of it, as by any
+/// texture's. Refused `Unsupported` where the device lacks the format as a depth attachment.
+pub(super) fn prepass_depth(maker: &CommandBuffer, layout: &PassLayout) -> Result<Target, Error> {
+    let device = maker.device();
+    let profile = device.compile_device().profile();
+    let pixel_format = PREPASS_DEPTH_FORMAT;
+    let usages = [FormatUsage::DepthStencilAttachment].into();
+    let mapping = metal2vulkan::metal::format::vk_format(pixel_format, &usages, profile).map_err(
+        |error| match error {
+            metal2vulkan::error::Error::Unsupported(unsupported) => Error::Unsupported(unsupported),
+            other => Error::Compile(other),
+        },
+    )?;
+    let format = mapping.format;
+    let extent = layout.extent;
+    let shaped = |k: &PooledBacking| {
+        k.pixel_format == pixel_format
+            && k.format == format
+            && k.samples == 1
+            && k.layers == 1
+            && k.extent == extent
+    };
+    let queue = maker.command_queue();
+    {
+        let mut pool = lock(queue.memoryless_backings());
+        pool.takes += 1;
+        let takes = pool.takes;
+        if let Some(found) = pool.kept.iter_mut().find(|k| shaped(k)) {
+            found.taken = takes;
+            let backing = found.backing.clone();
+            drop(pool);
+            maker.hold_own_texture(backing.texture.clone());
+            return Ok(backing);
+        }
+    }
+    let [width, height] = extent;
+    let descriptor = TextureDescriptor {
+        texture_type: TextureType::Type2D,
+        pixel_format,
+        width: width.into(),
+        height: height.into(),
+        array_length: 1,
+        sample_count: 1,
+        usage: TextureUsage::RENDER_TARGET,
+        resource_options: ResourceOptions::private(),
+        ..TextureDescriptor::default()
+    };
+    let plan = ImagePlan {
+        pixel_format,
+        flags: ImageCreateFlags::empty(),
+        image_type: ImageType::TYPE_2D,
+        format,
+        extent: [width, height, 1],
+        levels: 1,
+        layers: 1,
+        samples: sample_count(1).ok_or_else(|| internal("one sample, which Vulkan names"))?,
+        usage: ImageUsageFlags::DEPTH_STENCIL_ATTACHMENT,
+        view_formats: Vec::new(),
+        mapping,
+        unavailable: TextureUsage::SHADER_READ
+            | TextureUsage::SHADER_WRITE
+            | TextureUsage::SHADER_ATOMIC
+            | TextureUsage::PIXEL_FORMAT_VIEW,
+    };
+    // Made with no lock held; the pool may keep one another thread made meanwhile beside it.
+    let texture = Device::new_planned_texture(maker, &descriptor, plan)?;
+    let made = Target {
+        texture,
+        level: 0,
+        layer: 0,
+        layers: 1,
+        format,
+        samples: 1,
+        extent,
+    };
+    device.shared().counts.pooled_backing_made();
+    let mut pool = lock(queue.memoryless_backings());
+    pool.takes += 1;
+    let takes = pool.takes;
+    pool.kept.push(PooledBacking {
+        pixel_format,
+        format,
+        samples: 1,
+        layers: 1,
+        extent,
+        bytes: made.texture.placed_bytes().unwrap_or(0),
+        taken: takes,
+        backing: made.clone(),
+    });
+    pool.bound();
+    Ok(made)
+}
